# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=a1tex_db
DB_DIALECT=mysql
DB_PORT=3306

# Application URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
ADMIN_PANEL_URL=http://localhost:5173

# Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
COOKIE_SECRET=your_cookie_secret_key_here

# Default Admin Credentials
ADMIN_EMAIL=admin@a1tex.com
ADMIN_PASSWORD=your_secure_admin_password

# Email / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Internal Service Secrets
SERVICE_API_SECRET=your_service_api_secret
ORDER_SERVICE_SECRET=your_order_service_secret

# Shipping Defaults
FALLBACK_SHIPPING_RATE=100
FALLBACK_SHIPPING_DAYS=5
